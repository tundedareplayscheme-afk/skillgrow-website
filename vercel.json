{
  "functions": {
    "api/page.js": {
      "includeFiles": "index.html"
    }
  },
  "rewrites": [
    { "source": "/:page(sen|mainstream|staff-pwa|parent|trust|about|contact|privacy|security|pricing|faq)", "destination": "/api/page?page=:page" },
    { "source": "/:page(sen|mainstream|staff-pwa|parent|trust|about|contact|privacy|security|pricing|faq)/", "destination": "/api/page?page=:page" }
  ]
}
