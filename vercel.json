{
  "functions": {
    "api/page.js": {
      "includeFiles": "index.html"
    },
    "api/book.js": {
      "maxDuration": 30
    },
    "api/tes.js": {
      "maxDuration": 20
    }
  },
  "rewrites": [
    {
      "source": "/:page(sen|mainstream|staff-pwa|parent|trust|about|team|contact|privacy|security|pricing|faq|terms|dpa|accessibility|integrations|implementation|safeguarding|isp|book|tes|blog)",
      "destination": "/api/page?page=:page"
    },
    {
      "source": "/:page(sen|mainstream|staff-pwa|parent|trust|about|team|contact|privacy|security|pricing|faq|terms|dpa|accessibility|integrations|implementation|safeguarding|isp|book|tes|blog)/",
      "destination": "/api/page?page=:page"
    },
    {
      "source": "/book/:host(rubab|kajal)",
      "destination": "/api/page?page=book/:host"
    },
    {
      "source": "/book/:host(rubab|kajal)/",
      "destination": "/api/page?page=book/:host"
    },
    {
      "source": "/blog/:slug*",
      "destination": "/api/page?page=blog/:slug"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    }
  ],
  "headers": [
    {
      "source": "/tes",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
