{
  "functions": {
    "api/page.js": {
      "includeFiles": "index.html"
    },
    "api/book.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/:page(sen|mainstream|staff-pwa|parent|trust|about|team|contact|privacy|security|pricing|faq|terms|dpa|accessibility|integrations|implementation|safeguarding|isp|book|blog)",
      "destination": "/api/page?page=:page"
    },
    {
      "source": "/:page(sen|mainstream|staff-pwa|parent|trust|about|team|contact|privacy|security|pricing|faq|terms|dpa|accessibility|integrations|implementation|safeguarding|isp|book|blog)/",
      "destination": "/api/page?page=:page"
    },
    {
      "source": "/blog/:slug*",
      "destination": "/api/page?page=blog/:slug"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    }
  ]
}
