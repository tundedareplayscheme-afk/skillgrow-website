{
  "regions": ["lhr1"],
  "functions": {
    "api/page.js": {
      "includeFiles": "index.html"
    },
    "api/book.js": {
      "maxDuration": 30
    },
    "api/tes.js": {
      "maxDuration": 20
    },
    "api/team.js": {
      "maxDuration": 10
    },
    "api/team-photo.js": {
      "maxDuration": 15
    },
    "api/team-revalidate.js": {
      "maxDuration": 10
    },
    "api/dm-parents.js": {
      "maxDuration": 20
    }
  },
  "rewrites": [
    {
      "source": "/parents",
      "destination": "/dm-parents.html"
    },
    {
      "source": "/parents/",
      "destination": "/dm-parents.html"
    },
    {
      "source": "/team-photo/:id.webp",
      "destination": "/api/team-photo?id=:id"
    },
    {
      "source": "/:page(sen|mainstream|staff-pwa|parent|trust|about|team|contact|privacy|security|pricing|faq|terms|dpa|accessibility|integrations|implementation|who-we-work-with|safeguarding|isp|book|tes|blog)",
      "destination": "/api/page?page=:page"
    },
    {
      "source": "/:page(sen|mainstream|staff-pwa|parent|trust|about|team|contact|privacy|security|pricing|faq|terms|dpa|accessibility|integrations|implementation|who-we-work-with|safeguarding|isp|book|tes|blog)/",
      "destination": "/api/page?page=:page"
    },
    {
      "source": "/book/:host(rubab|kajal)",
      "destination": "/api/page?page=book/:host"
    },
    {
      "source": "/book/:host(rubab|kajal)/",
      "destination": "/api/page?page=book/:host"
    },
    {
      "source": "/blog/:slug*",
      "destination": "/api/page?page=blog/:slug"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    }
  ],
  "headers": [
    {
      "source": "/tes",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/parents",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/dm-parents.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/video/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
